# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (use * to allow all)
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database: change DB_TYPE + DATABASE_URL to switch ----
# DB_TYPE=postgres  ->  DATABASE_URL=postgres://user:pass@localhost:5432/clothswap
# DB_TYPE=mongo     ->  DATABASE_URL=mongodb://localhost:27017   (or an Atlas mongodb+srv:// URL)
DB_TYPE=postgres
DATABASE_URL=postgres://clothswap:clothswap@localhost:5432/clothswap
DB_SSL=false
MONGO_DB_NAME=clothswap

# ---- Image storage: local | cloudinary | s3 ----
STORAGE_DRIVER=local

# local (dev only on hosts with ephemeral disks)
LOCAL_UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# cloudinary (either set CLOUDINARY_URL, or the three values below)
# CLOUDINARY_URL=cloudinary://key:secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# s3 (works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces...)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for stored files, e.g. https://cdn.example.com  (default: AWS virtual-hosted URL)
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ---- Optional: create an admin account at startup ----
ADMIN_EMAIL=admin@clothswap.test
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Admin
